<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml">
    <head>
        <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title><%= title %></title>
        <link rel="stylesheet" href="maps.css">
        <script type="text/javascript" src="http://maps.google.com/maps/api/js?key=<%= apiKey %>&sensor=false&v=3.3"></script>
        <script type="text/javascript" src="maps.js" ></script>
        <!-- Latest compiled and minified CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- Latest compiled JavaScript -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
        
    </head>

    <body>
        <div id="wrapper">
            <div id="map"></div>
            <div id="sidebar">
                <div id="controls" class="container">
                    <div class="input-group mb-3">
                        <!-- <button type="button" onClick="reset()" >Reset</button> -->
                        <button type="button" class="btn btn-secondary" onClick="reset()">Reset</button>
                    </div>
                    <form id ="dateTime">
                    <!-- Date: <input type="text" name="date" id="date"/> -->
                        <div class="input-group mb-3">
                            <span class="input-group-text">IMEI</span>
                            <input type="text" class="form-control" name="imei" id="imei" placeholder="IMEI" value="352254060256234">
                             &nbsp; &nbsp; &nbsp;

                            <span class="input-group-text">Date</span>
                            <input type="date" class="form-control" name="date" id="date" placeholder="Date">
                             &nbsp; &nbsp; &nbsp;
                            <!-- <span class="input-group-btn input-space"> -->
                                <span class="input-group-text">Time</span>
                                <input type="time" class="form-control" name="time" id="time" placeholder="Time" step="1">
                            <!-- </span> -->
                             &nbsp; &nbsp; &nbsp;

                             
                        </div>
                        
                        <div class="input-group mb-3">
                            
                            <label class="input-group-text" for="eventType">Event</label>
                            <select class="form-select" id="eventType">
                                <option value="position">Position</option>
                                <option value="login">Login</option>
                                <option value="ignition_on">Ignition On</option>
                                <option value="ignition_off">Ignition Off</option>
                            </select>
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="placeHoldersCB" name="placeHoldersCB" value="no">
                                <label class="form-check-label" for="placeHoldersCB">Use Placeholders</label>
                            </div>
                        </div>
                    </form>
                    <div >
                        <textarea id="GPRMC" class="form-control" rows="10" ></textarea>
                        &nbsp;
                        <textarea id="FOXEVENTS" class="form-control" rows="10"></textarea>
                        &nbsp;
                        <textarea id="decDeg" class="form-control" rows="10"></textarea>
                    </div>
                </div>
                
            </div>
        </div>

         <script>
            const dateElement = document.getElementById('date');
            dateElement.valueAsDate = new Date();

            const timeElement = document.getElementById('time');
            timeElement.value = new Date().toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});

            const placeHoldersCB = document.getElementById('placeHoldersCB')

            placeHoldersCB.addEventListener('change', (event) => {
                if (event.currentTarget.checked) {
                    timeElement.disabled = true;
                    dateElement.disabled = true;
                } else {
                    timeElement.disabled = false;
                    dateElement.disabled = false;
                }
            })
        </script>
    </body>
</html>